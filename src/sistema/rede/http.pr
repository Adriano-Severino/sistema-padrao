espaco Sistema.Rede {

    publico classe ClienteHttp 
    {
        publico texto BaseUrl { obter; definir; }
        
        publico ClienteHttp() {}
        
        publico ClienteHttp(texto baseUrl) 
        {
            este.BaseUrl = baseUrl;
        }
        
        // GET
        @Nativo("ClienteHttp::Get")
        publico externo texto Get(texto url);
        
        // POST
        @Nativo("ClienteHttp::Post")
        publico externo texto Post(texto url, texto corpo);
        
        // PUT
        @Nativo("ClienteHttp::Put")
        publico externo texto Put(texto url, texto corpo);
        
        // DELETE
        @Nativo("ClienteHttp::Delete")
        publico externo texto Delete(texto url);
    }
}
