espaco Sistema.Rede {

    publico classe ClienteHttp 
    {
        publico texto BaseUrl { obter; definir; }
        
        publico ClienteHttp() {}
        
        publico ClienteHttp(texto baseUrl) 
        {
            este.BaseUrl = baseUrl;
        }
        
        // Síncronos
        [Nativo("ClienteHttp::Obter")]
        publico externo texto Obter(texto url);
        
        [Nativo("ClienteHttp::Enviar")]
        publico externo texto Enviar(texto url, texto corpo);
        
        [Nativo("ClienteHttp::Atualizar")]
        publico externo texto Atualizar(texto url, texto corpo);
        
        [Nativo("ClienteHttp::Excluir")]
        publico externo texto Excluir(texto url);
        
        // Assíncronos
        [Nativo("ClienteHttp::ObterAssincrono")]
        publico assíncrona externo texto ObterAssincrono(texto url);
        
        [Nativo("ClienteHttp::EnviarAssincrono")]
        publico assíncrona externo texto EnviarAssincrono(texto url, texto corpo);
        
        [Nativo("ClienteHttp::AtualizarAssincrono")]
        publico assíncrona externo texto AtualizarAssincrono(texto url, texto corpo);
        
        [Nativo("ClienteHttp::ExcluirAssincrono")]
        publico assíncrona externo texto ExcluirAssincrono(texto url);
    }
}
