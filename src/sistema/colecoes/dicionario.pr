espaco Sistema.Colecoes 
{
    publico classe Dicionario<TChave, TValor> 
    {
        privado inteiro tamanho;
        
        publico inteiro Tamanho 
        { 
            obter { retorne este.tamanho; }
        }
        
        publico Dicionario() 
        {
            este.tamanho = 0;
        }
        
        // Adicionar ou atualizar
        [Nativo("Dicionario::Adicionar")]
        publico externo vazio Adicionar(TChave chave, TValor valor);
        
        // Obter valor
        [Nativo("Dicionario::Obter")]
        publico externo TValor Obter(TChave chave);
        
        // Verificar se contém chave
        [Nativo("Dicionario::ContemChave")]
        publico externo booleano ContemChave(TChave chave);
        
        // Remover entrada
        [Nativo("Dicionario::Remover")]
        publico externo booleano Remover(TChave chave);
        
        // Limpar
        [Nativo("Dicionario::Limpar")]
        publico externo vazio Limpar();
    }
}
