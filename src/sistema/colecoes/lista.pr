espaco Sistema.Colecoes 
{
    publico classe Lista<T> 
    {

        privado T[] itens;
        privado inteiro tamanho;
        privado inteiro capacidade;
        
        publico inteiro Tamanho 
        { 
            obter { retorne este.tamanho; }
        }
        
        publico inteiro Capacidade 
        {
            obter { retorne este.capacidade; }
        }
        
        publico Lista() 
        {
            este.capacidade = 4;
            este.itens = novo T[este.capacidade];
            este.tamanho = 0;
        }
        
        publico Lista(inteiro capacidadeInicial) 
        {
            este.capacidade = capacidadeInicial;
            este.itens = novo T[este.capacidade];
            este.tamanho = 0;
        }
        
        // Adicionar item
        publico vazio Adicionar(T item) 
        {
            se (este.tamanho >= este.capacidade) 
            {
                este.RedimensionarArray();
            }
            este.itens[este.tamanho] = item;
            este.tamanho = este.tamanho + 1;
        }
        
        // Obter item por índice
        publico T Obter(inteiro indice) 
        {
            se (indice < 0 || indice >= este.tamanho) 
            {
                imprima("Índice fora dos limites");
                retorne nulo;
            }
            retorne este.itens[indice];
        }
        
        // Definir item por índice
        publico vazio Definir(inteiro indice, T item) 
        {
            se (indice < 0 || indice >= este.tamanho) {
                imprima("Índice fora dos limites");
                retorne;
            }
            este.itens[indice] = item;
        }
        
        // Remover item por índice
        publico vazio RemoverEm(inteiro indice) 
        {
            se (indice < 0 || indice >= este.tamanho) 
            {
                retorne;
            }
            
            inteiro i = indice;
            enquanto (i < este.tamanho - 1) 
            {
                este.itens[i] = este.itens[i + 1];
                i = i + 1;
            }
            este.tamanho = este.tamanho - 1;

        }
        
        // Remover item por valor
        publico booleano Remover(T item) 
        {
            inteiro i = 0;
            enquanto (i < este.tamanho) {
                se (este.itens[i] == item) {
                    este.RemoverEm(i);
                    retorne verdadeiro;
                }
                i = i + 1;
            }
            retorne falso;
        }
        
        // Verificar se contém item
        publico booleano Contem(T item) 
        {
            inteiro i = 0;
            enquanto (i < este.tamanho) {
                se (este.itens[i] == item) {
                    retorne verdadeiro;
                }
                i = i + 1;
            }
            retorne falso;
        }
        
        // Limpar lista
        publico vazio Limpar() 
        {
            este.tamanho = 0;
        }
        
        // Encontrar índice de um item
        publico inteiro IndiceDe(T item) 
        {
            inteiro i = 0;
            enquanto (i < este.tamanho) 
            {
                se (este.itens[i] == item) {
                    retorne i;
                }
                i = i + 1;
            }
            retorne -1;
        }
        
        // Verificar se a lista está vazia
        publico booleano EstaVazia() 
        {
            retorne este.tamanho == 0;
        }
        
        // Retorna o primeiro elemento
        publico T ObterPrimeiro() 
        {
            se (este.tamanho == 0) 
            {
                retorne nulo;
            }
            retorne este.itens[0];
        }
        
        // Retorna o último elemento
        publico T ObterUltimo() 
        {
            se (este.tamanho == 0) 
            {
                retorne nulo;
            }
            retorne este.itens[este.tamanho - 1];
        }
        
        // Inverte a ordem dos elementos in-place
        publico vazio Inverter() 
        {
            inteiro i = 0;
            inteiro j = este.tamanho - 1;
            enquanto (i < j) 
            {
                T temp = este.itens[i];
                este.itens[i] = este.itens[j];
                este.itens[j] = temp;
                i = i + 1;
                j = j - 1;
            }
        }
        
        // Ordena os elementos em ordem crescente (ordenação estável por comparação natural)
        [Nativo("Lista::Ordenar")]
        publico externo vazio Ordenar();
        
        // Ordena os elementos em ordem decrescente
        [Nativo("Lista::OrdenarDecrescente")]
        publico externo vazio OrdenarDecrescente();

        // Insere um item na posição indicada, deslocando os demais
        [Nativo("Lista::Inserir")]
        publico externo vazio Inserir(inteiro indice, T item);

        // Remove e retorna o último elemento
        [Nativo("Lista::RemoverUltimo")]
        publico externo T RemoverUltimo();

        // Adiciona o item somente se ele ainda não existir na lista
        [Nativo("Lista::AdicionarSeAusente")]
        publico externo booleano AdicionarSeAusente(T item);

        // Retorna os elementos como um array
        [Nativo("Lista::ParaArray")]
        publico externo T[] ParaArray();

        // Retorna uma sublista do intervalo [inicio, fim)
        publico Lista Recortar(inteiro inicio, inteiro fim) 
        {
            var sublista = novo Lista();
            se (inicio < 0) 
            {
                inicio = 0;
            }
            se (fim > este.tamanho) 
            {
                fim = este.tamanho;
            }
            inteiro i = inicio;
            enquanto (i < fim) 
            {
                sublista.Adicionar(este.itens[i]);
                i = i + 1;
            }
            retorne sublista;
        }
        
        privado vazio RedimensionarArray() 
        {
            este.capacidade = este.capacidade * 2;
            var novosItens = novo T[este.capacidade];
            inteiro i = 0;
            enquanto (i < este.tamanho) 
            {
                novosItens[i] = este.itens[i];
                i = i + 1;
            }
            este.itens = novosItens;
        }
    }
}
