espaco Sistema.IO 
{
    publico estática classe Diretorio 
    {
        // Verificar se diretório existe
        [Nativo("Diretorio::Existe")]
        publico estática externo booleano Existe(texto caminho);
        
        // Criar diretório
        [Nativo("Diretorio::Criar")]
        publico estática externo vazio Criar(texto caminho);
        
        // Excluir diretório
        [Nativo("Diretorio::Excluir")]
        publico estática externo vazio Excluir(texto caminho, booleano recursivo);
        
        // Obter diretório atual
        [Nativo("Diretorio::ObterAtual")]
        publico estática externo texto ObterAtual();
        
        // Definir diretório atual
        [Nativo("Diretorio::DefinirAtual")]
        publico estática externo vazio DefinirAtual(texto caminho);
        
        // Listar arquivos de um diretório (somente o nome de cada arquivo)
        [Nativo("Diretorio::ObterArquivos")]
        publico estática externo texto[] ObterArquivos(texto caminho);
        
        // Listar subdiretórios de um diretório (somente o nome de cada um)
        [Nativo("Diretorio::ObterDiretorios")]
        publico estática externo texto[] ObterDiretorios(texto caminho);
    }
}
