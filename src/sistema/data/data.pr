espaco Sistema.Data 
{
    publico classe Data 
    {
        publico inteiro Ano { obter; definir; }
        publico inteiro Mes { obter; definir; }
        publico inteiro Dia { obter; definir; }
        publico inteiro Hora { obter; definir; }
        publico inteiro Minuto { obter; definir; }
        publico inteiro Segundo { obter; definir; }
        
        publico Data(inteiro ano, inteiro mes, inteiro dia) 
        {
            este.Ano = ano;
            este.Mes = mes;
            este.Dia = dia;
            este.Hora = 0;
            este.Minuto = 0;
            este.Segundo = 0;
        }
        
        publico Data(inteiro ano, inteiro mes, inteiro dia, inteiro hora, inteiro minuto, inteiro segundo) 
        {
            este.Ano = ano;
            este.Mes = mes;
            este.Dia = dia;
            este.Hora = hora;
            este.Minuto = minuto;
            este.Segundo = segundo;
        }

        // Data atual — implementação nativa
        [Nativo("Data::Agora")]
        publico estática externo Data Agora();
        
        // Apenas data (sem hora) — implementação nativa
        [Nativo("Data::Hoje")]
        publico estática externo Data Hoje();
        
        // Formatar como string (sem formato — usa padrão dd/MM/aaaa HH:mm:ss)
        publico texto ParaTexto()
        {
            retorne $"{este.Dia}/{este.Mes}/{este.Ano} {este.Hora}:{este.Minuto}:{este.Segundo}";
        }
        
        // Formatar com formato personalizado — implementação nativa
        [Nativo("Data::Formatar")]
        publico externo texto Formatar(texto formato);
        
        // Comparações
        publico booleano Igual(Data outra) 
        {
            retorne este.Ano == outra.Ano && 
                   este.Mes == outra.Mes && 
                   este.Dia == outra.Dia &&
                   este.Hora == outra.Hora &&
                   este.Minuto == outra.Minuto &&
                   este.Segundo == outra.Segundo;
        }
    }
}
